{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://whiskeybar.site/schemas/brand-eval-manifest-v1.json",
  "title": "Brand recognition evaluation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "cases"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image",
        "condition",
        "expected_whiskey_id",
        "expected_canonical_name"
      ],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.(?:[jJ][pP][gG]|[jJ][pP][eE][gG]|[pP][nN][gG]|[wW][eE][bB][pP])$"
        },
        "condition": {
          "enum": [
            "bottle_front",
            "bottle_angle",
            "reflection_or_condensation",
            "partially_occluded",
            "box_only",
            "miniature",
            "glass_only",
            "multiple_bottles",
            "low_resolution",
            "back_label_only"
          ]
        },
        "expected_whiskey_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "expected_canonical_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "expected_brand_key": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "needs_review": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expected_whiskey_id": {
                "type": "string"
              }
            },
            "required": [
              "expected_whiskey_id"
            ]
          },
          "then": {
            "properties": {
              "expected_canonical_name": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
