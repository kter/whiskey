{
  "name": "infra",
  "version": "0.1.0",
  "bin": {
    "infra": "bin/infra.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest",
    "cdk": "cdk",
    "deploy:dev": "./scripts/deploy.sh dev --base",
    "deploy:prd": "./scripts/deploy.sh prd --base",
    "diff:dev": "./scripts/deploy.sh dev --base --diff-only",
    "diff:prd": "./scripts/deploy.sh prd --base --diff-only",
    "deploy:observability:dev": "./scripts/deploy.sh dev --observability",
    "deploy:observability:prd": "./scripts/deploy.sh prd --observability",
    "diff:observability:dev": "./scripts/deploy.sh dev --observability --diff-only",
    "diff:observability:prd": "./scripts/deploy.sh prd --observability --diff-only",
    "synth:dev": "CDK_LOCAL_BUNDLING=1 cdk synth -c env=dev",
    "synth:prd": "CDK_LOCAL_BUNDLING=1 cdk synth -c env=prd",
    "destroy:dev": "./scripts/deploy.sh dev --base --destroy",
    "destroy:prd": "./scripts/deploy.sh prd --base --destroy"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "22.7.9",
    "jest": "^30.4.2",
    "ts-jest": "^29.2.5",
    "aws-cdk": "2.1016.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.196.0",
    "constructs": "^10.0.0"
  }
}
